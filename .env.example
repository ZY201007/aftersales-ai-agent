# ========== LLM 提供方 ==========
# mock    : 使用内置的确定性 MockLLM，零 API Key 即可运行（默认）
# openai  : 使用 OpenAI 兼容端点
LLM_PROVIDER=mock

# ========== OpenAI 兼容端点配置（LLM_PROVIDER=openai 时生效）==========
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo

# ========== 成本估算单价（单位：元 / 千 token）==========
PRICE_INPUT_PER_1K=0.0015
PRICE_OUTPUT_PER_1K=0.0020

# 每次转人工的人工处理成本（元/单），用于成本对比
HUMAN_COST_PER_TICKET=8.0
